{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WAVEX_TEST": "OFF"
      }
    },
    {
      "name": "test-profile",
      "displayName": "Dev",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "WAVEX_TEST": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Tests — Thread Sanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "WAVEX_TEST_TSAN": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Tests — Address + UB + Leak Sanitizers",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "WAVEX_TEST_ASAN": "ON"
      }
    }
  ],
  "testPresets": [
    {
      "name": "run-tests",
      "configurePreset": "test-profile"
    },
    {
      "name": "tsan",
      "displayName": "Run Thread Sanitizer tests",
      "configurePreset": "tsan",
      "filter": {
        "include": {
          "label": "tsan"
        }
      }
    },
    {
      "name": "asan",
      "displayName": "Run Address + UB + Leak Sanitizer tests",
      "configurePreset": "asan",
      "filter": {
        "include": {
          "label": "asan"
        }
      }
    }
  ]
}

